{
  "expo": {
    "name": "Ripe Weekly",
    "slug": "ripe-weekly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.letsbelikesophie.ripeweekly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5FB3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.letsbelikesophie.ripeweekly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-sharing",
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "color": "#2F5FB3"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "리포트 카드 이미지를 사진에 저장하려고 써요.",
          "savePhotosPermission": "리포트 카드 이미지를 사진에 저장하려고 써요."
        }
      ]
    ],
    "scheme": "ripeweekly",
    "experiments": {
      "typedRoutes": false
    }
  }
}
